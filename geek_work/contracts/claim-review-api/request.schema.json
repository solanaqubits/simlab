{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim Review Local API 0.1 requests — specification",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "context": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "claim-review-api-request-1"
        },
        "operation": {
          "const": "context"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "context_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "schema",
        "operation",
        "request_id",
        "context_id"
      ],
      "additionalProperties": false
    },
    "drafts": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "claim-review-api-request-1"
        },
        "operation": {
          "const": "drafts"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "context_id": {
          "$ref": "#/$defs/id"
        },
        "parent_draft_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_sha256": {
          "$ref": "#/$defs/hash"
        },
        "record_base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1398104,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
        }
      },
      "required": [
        "schema",
        "operation",
        "request_id",
        "context_id",
        "parent_draft_id",
        "record_sha256",
        "record_base64"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "claim-review-api-request-1"
        },
        "operation": {
          "const": "checks"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "context_id": {
          "$ref": "#/$defs/id"
        },
        "draft_id": {
          "$ref": "#/$defs/id"
        },
        "draft_sha256": {
          "$ref": "#/$defs/hash"
        },
        "context_fingerprint": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "schema",
        "operation",
        "request_id",
        "context_id",
        "draft_id",
        "draft_sha256",
        "context_fingerprint"
      ],
      "additionalProperties": false
    },
    "builds": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "claim-review-api-request-1"
        },
        "operation": {
          "const": "builds"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "context_id": {
          "$ref": "#/$defs/id"
        },
        "draft_id": {
          "$ref": "#/$defs/id"
        },
        "draft_sha256": {
          "$ref": "#/$defs/hash"
        },
        "context_fingerprint": {
          "$ref": "#/$defs/hash"
        }
      },
      "required": [
        "schema",
        "operation",
        "request_id",
        "context_id",
        "draft_id",
        "draft_sha256",
        "context_fingerprint"
      ],
      "additionalProperties": false
    },
    "jobs_status": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "claim-review-api-request-1"
        },
        "operation": {
          "const": "jobs/status"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "context_id": {
          "$ref": "#/$defs/id"
        },
        "job_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "schema",
        "operation",
        "request_id",
        "context_id",
        "job_id"
      ],
      "additionalProperties": false
    },
    "artifacts_read": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "claim-review-api-request-1"
        },
        "operation": {
          "const": "artifacts/read"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "context_id": {
          "$ref": "#/$defs/id"
        },
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/hash"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      },
      "required": [
        "schema",
        "operation",
        "request_id",
        "context_id",
        "artifact_id",
        "artifact_sha256",
        "offset",
        "max_bytes"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/context"
    },
    {
      "$ref": "#/$defs/drafts"
    },
    {
      "$ref": "#/$defs/checks"
    },
    {
      "$ref": "#/$defs/builds"
    },
    {
      "$ref": "#/$defs/jobs_status"
    },
    {
      "$ref": "#/$defs/artifacts_read"
    }
  ]
}
